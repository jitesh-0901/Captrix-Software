# ==============================================================================
# CAPTRIX AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or backend/.env and frontend/.env as needed.
# DO NOT COMMIT PRIVATE PASSWORDS, CREDENTIALS, OR SIGNATURES INTO REPOSITORY.
# ==============================================================================

# Backend Django Settings
DEBUG=True
SECRET_KEY=captrix-local-development-secret-key-change-in-production-only-2026
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Defaults to SQLite for local development)
# DATABASE_URL=sqlite:///db.sqlite3

# Statutory Audit & ICAI Compliance Flags
ALLOW_SYNTHETIC_DEMO=True
ENFORCE_TENANT_ISOLATION=True
MAX_UPLOAD_SIZE_MB=100

# Frontend Environment Variables (frontend/.env)
VITE_API_URL=http://localhost:8000
